<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_brand"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="TELEMUSIC"
                    android:textColor="#FFE64366"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TeleMusic"
                android:textSize="19sp"
                android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to open"
                android:textSize="14sp"
                android:textColor="#FF8E8D93" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <ImageView
        android:id="@+id/widget_like"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_widget_star"
        android:contentDescription="Like" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_time_elapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textSize="12sp"
            android:textColor="#FF8E8D93" />
        <TextView
            android:id="@+id/widget_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-0:00"
            android:textSize="12sp"
            android:textColor="#FF8E8D93" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
        android:id="@+id/widget_shuffle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_widget_shuffle"
        android:contentDescription="Shuffle" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="9dp"
        android:src="@drawable/ic_widget_prev"
        android:contentDescription="Previous" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView
        android:id="@+id/widget_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="15dp"
        android:background="@drawable/widget_play_bg"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="Play or pause" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="9dp"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="Next" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView
        android:id="@+id/widget_repeat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_widget_repeat"
        android:contentDescription="Repeat" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_upnext_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="UP NEXT"
        android:textSize="12sp"
        android:textColor="#FF8E8D93"
        android:letterSpacing="0.06"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_next1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_next1_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_next1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_next1_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FF8E8D93" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_next2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_next2_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_placeholder"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_next2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_next2_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FF8E8D93" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
